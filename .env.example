# LLM / Embeddings (PydanticAI-Modellnamen, z. B. openai:gpt-5-mini, anthropic:claude-sonnet-5-5, ollama:llama3.3)
OPENAI_API_KEY=
LLM_MODEL=openai:gpt-5-mini
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIM=1536

# Datenbank
DATABASE_URL=postgresql+asyncpg://adventure:adventure@localhost:5440/adventure
TEST_DATABASE_URL=postgresql+asyncpg://adventure:adventure@localhost:5440/adventure_test

# Auth
JWT_SECRET=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# Externe Dienste
# Kostenloser Key: https://openrouteservice.org/dev/#/signup (ohne Key: Luftlinien-Schätzung)
ORS_API_KEY=
NOMINATIM_USER_AGENT=AgenticRagAdventurePlanner/0.1 (contact: you@example.com)

CORS_ORIGINS=http://localhost:5180
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# Kartenhintergrund im PDF-Export (OSM-Kacheln, Tile-Policy beachten); leer = ohne Karte
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
